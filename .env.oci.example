# ==============================================================================
# NexusFin AI — Oracle Cloud Always Free ARM64 + Vercel Hybrid Environment
# Copy to .env.oci on your OCI VM before starting docker compose.
# ==============================================================================

# Replace <OCI_PUBLIC_IP> with your VM's public IP (or your own custom domains)
API_DOMAIN=api.<OCI_PUBLIC_IP>.sslip.io
AUTH_DOMAIN=auth.<OCI_PUBLIC_IP>.sslip.io

# Exact Vercel production origin(s) for CORS & Keycloak redirect URI registration
VERCEL_APP_URL=https://your-project.vercel.app
NEXUSFIN_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-project.vercel.app,https://*.vercel.app

# Required database & IAM secrets (set strong random values)
POSTGRES_PASSWORD=change-me-strong-postgres-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-strong-keycloak-password

# Optional OpenAI key (leave empty or dummy-key to use built-in heuristic engine)
OPENAI_API_KEY=dummy-key
