# ==============================================================================
# NexusFin AI - Environment Configuration Example
# Copy to .env and set your secrets before launching
# ==============================================================================

# Database Credentials (Required: no default in application.yml)
POSTGRES_DB=nexusfin_ledger
POSTGRES_USER=nexusfin
POSTGRES_PASSWORD=your-postgres-password-here
SPRING_DATASOURCE_PASSWORD=your-postgres-password-here
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexusfin_ledger

# Edge Gateway Security (Required: no default in application.yml)
NEXUSFIN_SECURITY_ENABLED=false
NEXUSFIN_API_KEY=your-nexusfin-api-key-here

# OpenAI & Spring AI API Key (Optional: heuristic fallback enabled if missing)
OPENAI_API_KEY=your-openai-api-key-here

# Keycloak IAM (OAuth 2.0 / OIDC Provider)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URI=http://localhost:8083/realms/nexusfin

# Eureka Discovery Service
EUREKA_URI=http://localhost:8761/eureka/

# Virtual Threads (JDK 21)
SPRING_THREADS_VIRTUAL_ENABLED=true
