# ==============================================================================
# NexusFin AI - Environment Configuration Example
# ==============================================================================

# Database Credentials
POSTGRES_DB=nexusfin_ledger
POSTGRES_USER=nexusfin
POSTGRES_PASSWORD=nexusfin_secret
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexusfin_ledger

# OpenAI & Spring AI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Eureka Discovery Service
EUREKA_URI=http://localhost:8761/eureka/

# Virtual Threads (JDK 21)
SPRING_THREADS_VIRTUAL_ENABLED=true
