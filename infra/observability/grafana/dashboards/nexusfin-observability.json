      "title": "DLT Quarantined Messages (Total / Active)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(dlt_messages_total) or vector(0)",
          "legendFormat": "Total Quarantined",
          "refId": "A"
