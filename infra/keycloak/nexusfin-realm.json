      },
      {
        "id": "role-admin",
        "name": "ADMIN",
        "description": "Administrative role for chart of accounts management and system auditing"
      },
      {
        "id": "role-service",
        "name": "SERVICE",
        "description": "Service-to-service internal communication role for microservice federation"
      }
    ]
  },
  "clients": [
    {
      "id": "client-nexusfin-gateway",
