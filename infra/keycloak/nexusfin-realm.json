{
  "id": "nexusfin",
  "realm": "nexusfin",
  "enabled": true,
  "displayName": "NexusFin AI Financial Intelligence Platform",
  "sslRequired": "NONE",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "id": "role-customer",
        "name": "CUSTOMER",
