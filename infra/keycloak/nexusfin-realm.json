      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:4200/*",
        "http://127.0.0.1:8080/*",
        "http://127.0.0.1:4200/*"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    },
    {
      "id": "client-nexusfin-service",
      "clientId": "nexusfin-service",
      "name": "NexusFin Microservices Machine-to-Machine",
      "enabled": true,
      "publicClient": false,
      "secret": "nexusfin-service-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "roles",
        "profile",
        "email"
      ]
    }
  ],
